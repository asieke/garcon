# Copy to .env beside the canonical checkout. Never commit .env.
# Garcon itself reads no .env file and needs no secrets: settings live in
# ~/.config/garcon and provider CLIs own their logins.
# NAME=            where to obtain it
# Optional, development only: backend that scripts/dev.sh proxies to (default http://127.0.0.1:4141).
GARCON_BACKEND_URL=
